# Copy to .env; keep API keys on this computer only.
LLM_PROVIDER=cloud
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# llama.cpp example: provider=llamacpp, base_url=http://127.0.0.1:8080/v1
# A separate key prevents accidentally sending the cloud key to a local server.
LLAMACPP_API_KEY=

# schema: JSON Schema; json: JSON object; prompt: plain chat with app-side validation.
# Select according to the actual provider. No silent fallback or extra paid retries.
LLM_JSON_MODE=schema
# structured: JSON action protocol; native: provider-native tool_calls
AGENT_PROTOCOL=structured
LLM_TIMEOUT_SECONDS=90
LLM_CONTEXT_TOKENS=16384
LLM_MAX_OUTPUT_TOKENS=1800

MEETING_DATA_DIR=data
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
ASR_TIMEOUT_SECONDS=900
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
